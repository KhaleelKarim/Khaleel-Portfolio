# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; this file is committed as documentation.

# Google Analytics measurement ID (looks like G-XXXXXXXXXX).
# REQUIRED: app/layout.tsx throws an error at render time if this is missing.
# If you don't want analytics yet, any placeholder string will let the site run.
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=

# Where the /resume link sends people. Any public URL works —
# a Google Drive share link or a PDF hosted in public/ are both fine.
NEXT_PUBLIC_RESUME_LINK=

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
